# Copy the variables you need into your shell (or your own secrets tooling).
# Never commit real values.

# Required by every API example. Create a key at https://packetexchange.io/dashboard/api-keys
PACKETEXCHANGE_API_KEY=

# Optional. Defaults to https://packetexchange.io/api/v1.
# Point it at the mock API to run the examples without spending anything:
# PACKETEXCHANGE_BASE_URL=http://127.0.0.1:4010/api/v1
PACKETEXCHANGE_BASE_URL=

# webhooks: the endpoint's signing secret, shown once when you create it in the dashboard.
PACKETEXCHANGE_WEBHOOK_SECRET=
# webhooks: the port the receiver listens on (default 3000).
PORT=

# x402-topup: the 0x-prefixed private key of the wallet that pays in USDC.
# This key moves real funds. Use a dedicated wallet holding only what you intend to spend.
X402_PRIVATE_KEY=
